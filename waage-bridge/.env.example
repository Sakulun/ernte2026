# ═══════════════════════════════════════════════════════════════════════════
#  Waage-Bridge Konfiguration
#  Zwei Betriebsarten – nur EINE wird gebraucht:
#   A) TCP  (index.js)      – wenn die Waage per Netzwerk/IP erreichbar ist
#   B) OCR  (screen-ocr.js) – wenn nur die Bitzer-Anzeige am Bildschirm da ist
# ═══════════════════════════════════════════════════════════════════════════

# Supabase (für beide Betriebsarten nötig)
SUPABASE_URL=https://fijfxmjtoexpuxxjqqbf.supabase.co
# Service-Role-Key aus Supabase Dashboard > Settings > API
SUPABASE_KEY=HIER_SERVICE_ROLE_KEY_EINTRAGEN


# ── A) TCP-Betrieb (Schenck Disomat Opus per Netzwerk) ──────────────────────
WAAGE_IP=192.168.1.50
WAAGE_PORT=8000
POLL_CMD=SI
POLL_MS=2000


# ── B) Bildschirm-OCR (Bitzer-Anzeige ablesen) ──────────────────────────────
# Bildschirmausschnitt der Gewichtszahl (Pixel). Mit "node screen-ocr.js
# kalibrieren" einen Vollbild-Screenshot erzeugen und die Werte in Paint ablesen.
REGION_X=0
REGION_Y=0
REGION_W=400
REGION_H=120

# Monitor-Nummer bei mehreren Bildschirmen (leer = Standardbildschirm).
# "node screen-ocr.js kalibrieren" listet die verfügbaren Bildschirme auf.
MONITOR=

# Abfragetakt in Millisekunden
POLL_MS=1000

# Ausschnitt vor der OCR vergrößern (2–4 verbessert die Erkennung deutlich)
OCR_SCALE=3

# Anzeige-Einheit: kg oder t
# Bitzer-Waage Beesenstedt zeigt Tonnen an (z.B. "0,00 t") -> t
ANZEIGE_EINHEIT=t
# Feste Nachkommastellen der Anzeige.
# Bitzer zeigt "0,00 t" -> 2 Nachkommastellen. (kg-Anzeige meist 0.)
# Beispiel: Anzeige "40,50" + Einheit t + 2 Dezimalstellen = 40.500 kg
DEZIMALSTELLEN=2

# Dunkle Anzeige auf hellem Grund? Standard nein. Bei heller Schrift auf
# dunklem Hintergrund auf "ja" setzen (invertiert das Bild vor der OCR).
OCR_INVERTIEREN=nein

# Stabil-Erkennung: so viele gleiche Messungen (±Toleranz) = "stabil"
STABIL_AB=3
STABIL_TOLERANZ_KG=10

# Nach so vielen Fehllesungen in Folge -> Status "offline"
OFFLINE_NACH=5
